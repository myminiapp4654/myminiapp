{
  // F5 -> "Server + Telefon" yoki "Server + Chrome": lokal server va ilova birga.
  // Kodni saqlasangiz (Ctrl+S) o'zgarish darhol ko'rinadi (hot reload).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (lokal)",
      "type": "dart",
      "request": "launch",
      "program": "server/bin/server.dart",
      "cwd": "server",
      "env": {
        "DEV_LOGIN": "true",
        "PORT": "8080"
      }
    },
    {
      // USB orqali ulangan telefon. adb reverse telefondagi localhost:8080 ni
      // kompyuterdagi serverga yo'naltiradi
      "name": "Ilova (telefon)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "RZ8T60Z9E1A",
      "preLaunchTask": "adb reverse 8080"
    },
    {
      "name": "Ilova (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=5000"]
    }
  ],
  "compounds": [
    {
      "name": "Server + Telefon",
      "configurations": ["Server (lokal)", "Ilova (telefon)"],
      "stopAll": true
    },
    {
      "name": "Server + Chrome",
      "configurations": ["Server (lokal)", "Ilova (Chrome)"],
      "stopAll": true
    }
  ]
}
